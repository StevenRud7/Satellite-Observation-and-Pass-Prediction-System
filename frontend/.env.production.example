# This is documentation, not a file Vite reads - Cloudflare Pages builds
# from environment variables set in its own dashboard, not from a
# committed .env file (there's nothing secret in this one value, but the
# principle - and the "changing it requires a rebuild" gotcha - matters
# either way). See DEPLOYMENT.md Step 4 for exactly where to set this.
#
# Vite bakes VITE_-prefixed variables into the built JS bundle at BUILD
# TIME, not read at runtime - changing this value in Cloudflare Pages'
# dashboard later requires triggering a new deploy, not just a restart.

VITE_API_BASE_URL=https://satellite-obs-api.onrender.com
