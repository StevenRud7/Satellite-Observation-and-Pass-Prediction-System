# Copy this file to .env and fill in real values for local development.
# Never commit the actual .env file.

# development | staging | production
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

# Not used until database-backed features are needed (satellite caching
# persists to Postgres, saved observer locations, stored passes). Without
# this set, the app still runs fully - it falls back to an in-memory
# satellite cache and simply doesn't have persistence.
#
# Local Postgres (e.g. via the provided docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/satellite_obs
#
# Neon (or any hosted Postgres) - copy the connection string it gives you
# and change the scheme to postgresql+psycopg:// (this project uses the
# psycopg 3 driver, not psycopg2):
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
DATABASE_URL=

# How long (seconds) a fetched satellite's orbital data is considered fresh
# before it is re-fetched from CelesTrak. Default 21600 (6 hours). CelesTrak
# updates a few times per day and may block clients that fetch too often,
# so avoid setting this very low.
# ORBITAL_DATA_CACHE_TTL_SECONDS=21600
